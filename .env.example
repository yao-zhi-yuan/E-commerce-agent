APP_ENV=development
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=10
SSE_BLOCK_MILLISECONDS=5000
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=agent
RABBITMQ_PASSWORD=<SET_ME>
QUEUE_OPERATION_TIMEOUT_SECONDS=5

MCP_SERVER_URL=http://mcp:8000/mcp
KNOWLEDGE_DB_PATH=/data/knowledge.db
KNOWLEDGE_SOURCE_DIR=/app/knowledge

# mock 可离线运行；openai_compatible 会调用 {LLM_BASE_URL}/chat/completions。
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<SET_ME>
LLM_MODEL=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS=2048

TASK_TIMEOUT_SECONDS=180
MODEL_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=15
MAX_AGENT_ITERATIONS=12
MAX_REPEATED_STEPS=3
MAX_TOOL_CALLS_PER_TURN=8
MAX_PARALLEL_TOOLS=4
MAX_TASK_ATTEMPTS=4
WORKER_PREFETCH=4
